{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nordle:schema:doc:0.1",
  "title": "Nordle document",
  "description": "One piece of social content: a graphic, a carousel or a video, plus its post copy. Paths are relative to the project root and may not leave it.",
  "type": "object",
  "required": ["schema", "id", "title", "kind", "brand", "sizes"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema": { "const": "nordle.doc/0.1" },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "kind": { "enum": ["graphic", "carousel", "video"] },
    "brand": { "$ref": "#/$defs/id" },
    "colourway": { "$ref": "#/$defs/id" },
    "sizes": {
      "description": "Platform preset ids from data/platforms.json, or custom {id,w,h}.",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sizeRef" }
    },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "brief": {
      "description": "What this post is for. Claude writes it before designing and checks the result against it; the reviewer checks it again.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "goal": { "type": "string", "description": "What the post should make the viewer do or feel." },
        "audience": { "type": "string" },
        "message": { "type": "string", "description": "The one thing it says." },
        "tone": { "type": "string" },
        "mustInclude": { "type": "array", "items": { "type": "string" } },
        "mustAvoid": { "type": "array", "items": { "type": "string" } },
        "calendarItem": { "type": "string", "description": "Id of the calendar item this was built for." },
        "postDate": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "notes": { "type": "string" }
      }
    },
    "explore": {
      "description": "Marks this document as one of several alternative takes on another document (Explore mode).",
      "type": "object",
      "required": ["of"],
      "additionalProperties": false,
      "properties": {
        "of": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "maxLength": 80 },
        "note": { "type": "string", "maxLength": 1000 }
      }
    },
    "copy": { "$ref": "#/$defs/copy" },
    "pages": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/page" } },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "timeline": { "$ref": "#/$defs/timeline" },
    "layers": {
      "description": "Video only: overlay layers drawn over the timeline. Each needs a time range.",
      "type": "array",
      "items": { "$ref": "#/$defs/layer" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "video" } }, "required": ["kind"] },
      "then": { "required": ["timeline"], "not": { "required": ["pages"] } },
      "else": {
        "required": ["pages"],
        "not": { "anyOf": [{ "required": ["timeline"] }, { "required": ["layers"] }, { "required": ["sources"] }] }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "graphic" } }, "required": ["kind"] },
      "then": { "properties": { "pages": { "maxItems": 1 } } }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$", "maxLength": 64 },
    "relPath": {
      "description": "Relative path inside the project. No absolute paths, drive letters, backslashes or '..'.",
      "type": "string",
      "minLength": 1,
      "maxLength": 260,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*\\.\\.)(?!.*\\\\)[^\\u0000]+$"
    },
    "sizeRef": {
      "oneOf": [
        { "$ref": "#/$defs/id" },
        {
          "type": "object",
          "required": ["id", "w", "h"],
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "#/$defs/id" },
            "w": { "type": "integer", "minimum": 64, "maximum": 8192 },
            "h": { "type": "integer", "minimum": 64, "maximum": 8192 }
          }
        }
      ]
    },
    "length": {
      "description": "A number is a percentage of the canvas. A string may end in % or px (px is for a 1080-wide reference canvas and scales).",
      "oneOf": [{ "type": "number" }, { "type": "string", "pattern": "^-?\\d+(\\.\\d+)?(%|px)$" }]
    },
    "sizeLength": { "oneOf": [{ "$ref": "#/$defs/length" }, { "const": "auto" }] },
    "colour": {
      "type": "string",
      "pattern": "^(#[0-9a-fA-F]{3,8}|rgba?\\([0-9.,%\\s/]+\\)|hsla?\\([0-9.,%\\s/]+(deg)?[0-9.,%\\s/]*\\)|transparent|\\$brand\\.colors\\.[A-Za-z0-9_-]+)$"
    },
    "fontRef": {
      "oneOf": [
        { "type": "string", "pattern": "^\\$brand\\.fonts\\.[A-Za-z0-9_-]+$" },
        { "type": "string", "pattern": "^[^$].{0,80}$" }
      ]
    },
    "gradient": {
      "type": "object",
      "required": ["type", "stops"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["linear", "radial"] },
        "angle": { "type": "number" },
        "x": { "type": "number", "description": "Radial only: the centre, in percent of the width." },
        "y": { "type": "number", "description": "Radial only: the centre, in percent of the height." },
        "radius": { "type": "number", "exclusiveMinimum": 0, "description": "Radial only: how far the last stop is from the centre, in percent of the width." },
        "stops": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["at", "color"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "number", "minimum": 0, "maximum": 1 },
              "color": { "$ref": "#/$defs/colour" }
            }
          }
        }
      }
    },
    "fill": { "oneOf": [{ "$ref": "#/$defs/colour" }, { "$ref": "#/$defs/gradient" }] },
    "focal": {
      "type": "object",
      "required": ["x", "y"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "anchor": {
          "enum": ["top-left", "top", "top-right", "left", "center", "right", "bottom-left", "bottom", "bottom-right"]
        },
        "x": { "$ref": "#/$defs/length" },
        "y": { "$ref": "#/$defs/length" },
        "w": { "$ref": "#/$defs/sizeLength" },
        "h": { "$ref": "#/$defs/sizeLength" },
        "rotate": { "type": "number" },
        "z": { "type": "integer" }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "font": { "$ref": "#/$defs/fontRef" },
        "size": { "type": "number", "exclusiveMinimum": 0, "maximum": 2000 },
        "weight": { "type": "integer", "minimum": 100, "maximum": 900 },
        "italic": { "type": "boolean" },
        "uppercase": { "type": "boolean" },
        "underline": { "type": "boolean" },
        "color": { "$ref": "#/$defs/colour" },
        "align": { "enum": ["left", "center", "right", "justify"] },
        "lineHeight": { "type": "number", "minimum": 0.5, "maximum": 4 },
        "letterSpacing": { "type": "number", "minimum": -1, "maximum": 2 },
        "balance": { "type": "boolean" },
        "maxLines": { "type": "integer", "minimum": 1 },
        "fill": { "$ref": "#/$defs/fill" },
        "stroke": {
          "type": "object",
          "required": ["color", "width"],
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/colour" },
            "width": { "type": "number", "minimum": 0 }
          }
        },
        "radius": { "$ref": "#/$defs/length" },
        "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
        "blur": { "type": "number", "minimum": 0, "maximum": 300, "description": "Soften the whole layer (px on a 1080-wide page). Big blurred shapes make glows." },
        "blend": { "enum": ["normal", "screen", "multiply", "overlay", "soft-light", "hard-light", "color-dodge", "plus-lighter", "difference"], "description": "How the layer mixes with what is under it." },
        "shadow": {
          "type": "object",
          "required": ["color", "blur"],
          "additionalProperties": false,
          "properties": {
            "color": { "$ref": "#/$defs/colour" },
            "blur": { "type": "number", "minimum": 0 },
            "x": { "type": "number" },
            "y": { "type": "number" }
          }
        }
      }
    },
    "animation": {
      "description": "Either a named preset or explicit keyframes. Preset names are checked by the renderer, not the schema.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "at": { "type": "number", "minimum": 0 },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "ease": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "params": { "type": "object" },
        "keyframes": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "required": ["t", "prop", "value"],
            "additionalProperties": false,
            "properties": {
              "t": { "type": "number", "minimum": 0 },
              "prop": { "enum": ["x", "y", "w", "h", "rotate", "opacity", "scale", "blur", "draw"] },
              "value": { "type": "number" },
              "ease": { "type": "string", "pattern": "^[a-z0-9-]+$" }
            }
          }
        }
      },
      "anyOf": [{ "required": ["preset"] }, { "required": ["keyframes"] }]
    },
    "time": {
      "type": "object",
      "required": ["start", "end"],
      "additionalProperties": false,
      "properties": {
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "override": {
      "description": "Per-size changes to a layer. Only what differs from the base layer.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "layout": { "$ref": "#/$defs/layout" },
        "style": { "$ref": "#/$defs/style" },
        "hidden": { "type": "boolean" },
        "text": { "type": "string" },
        "animate": { "type": "array", "items": { "$ref": "#/$defs/animation" } }
      }
    },
    "run": {
      "type": "object",
      "required": ["text"],
      "additionalProperties": false,
      "properties": {
        "text": { "type": "string" },
        "style": { "$ref": "#/$defs/style" }
      }
    },
    "layer": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["text", "image", "video", "shape", "group"] },
        "name": { "type": "string" },
        "lock": { "type": "boolean" },
        "hidden": { "type": "boolean" },
        "ignoreSafe": {
          "description": "Do not warn when this layer sits in the area platform UI covers (page numbers, footers, bleeds).",
          "type": "boolean"
        },
        "layout": { "$ref": "#/$defs/layout" },
        "style": { "$ref": "#/$defs/style" },
        "overrides": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "$ref": "#/$defs/override" }
        },
        "animate": { "type": "array", "items": { "$ref": "#/$defs/animation" } },
        "time": { "$ref": "#/$defs/time" },
        "alt": { "type": "string" },
        "text": { "type": "string" },
        "runs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/run" } },
        "src": { "$ref": "#/$defs/relPath" },
        "source": { "$ref": "#/$defs/id" },
        "in": { "type": "number", "minimum": 0 },
        "out": { "type": "number", "exclusiveMinimum": 0 },
        "volume": { "type": "number", "minimum": 0, "maximum": 2 },
        "fit": { "enum": ["cover", "contain", "fill"] },
        "focal": { "$ref": "#/$defs/focal" },
        "shape": { "enum": ["rect", "ellipse", "line", "path"] },
        "d": { "type": "string", "maxLength": 3000, "pattern": "^[MmLlHhVvCcSsQqTtAaZz0-9eE.,+\\-\\s]+$", "description": "Path shapes only: the outline, drawn in a 100 by 100 box that is stretched to the layer (SVG path commands: M L H V C S Q T A Z). Stroke it with style.stroke; the draw animation traces it." },
        "children": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
        "stack": {
          "description": "Group only. Lay the children out top to bottom, one after another, with this gap (px on a 1080-wide page). Children then ignore x, y and anchor; only their width (and height) count. Text can never overlap inside a stack.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gap": { "type": "number", "minimum": 0, "maximum": 400 },
            "align": { "enum": ["start", "center", "end", "stretch"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "text" } }, "required": ["type"] },
          "then": { "anyOf": [{ "required": ["text"] }, { "required": ["runs"] }] }
        },
        {
          "if": { "properties": { "type": { "const": "image" } }, "required": ["type"] },
          "then": { "required": ["src"] }
        },
        {
          "if": { "properties": { "type": { "const": "video" } }, "required": ["type"] },
          "then": { "required": ["source"] }
        },
        {
          "if": { "properties": { "type": { "const": "shape" } }, "required": ["type"] },
          "then": { "required": ["shape"] }
        },
        {
          "if": { "properties": { "type": { "const": "group" } }, "required": ["type"] },
          "then": { "required": ["children"] }
        }
      ]
    },
    "page": {
      "type": "object",
      "required": ["id", "layers"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "background": { "$ref": "#/$defs/fill" },
        "lock": { "description": "Claude cannot change a locked page or anything on it.", "type": "boolean" },
        "layers": { "type": "array", "items": { "$ref": "#/$defs/layer" } },
        "notes": { "type": "string" }
      }
    },
    "copy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caption": { "type": "string" },
        "cta": { "type": "string" },
        "hashtags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^#?[\\p{L}\\p{N}_]+$" }
        },
        "alt": {
          "description": "Alt text by page id (or 'video' for a video).",
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/id" },
          "additionalProperties": { "type": "string" }
        },
        "platforms": {
          "type": "object",
          "propertyNames": {
            "enum": ["instagram", "facebook", "tiktok", "youtube", "linkedin", "x", "pinterest", "threads"]
          },
          "additionalProperties": { "$ref": "#/$defs/copyOverride" }
        },
        "notes": { "type": "string" }
      }
    },
    "copyOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caption": { "type": "string" },
        "cta": { "type": "string" },
        "hashtags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^#?[\\p{L}\\p{N}_]+$" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["id", "type", "path"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["video", "audio", "image"] },
        "path": { "$ref": "#/$defs/relPath" },
        "duration": { "type": "number", "exclusiveMinimum": 0 },
        "transcript": { "$ref": "#/$defs/relPath" },
        "lutRange": { "enum": ["full", "tv"], "description": "How the LUT reads this source: Sony log files are full-range data (the default). Use tv for footage that really is limited range." },
        "lut": { "description": "A .cube colour LUT (a project path or a mount path) put on every clip of this source before anything else, for camera-log footage such as S-Log3 that has to be brought to Rec.709.", "$ref": "#/$defs/relPath" },
        "exposure": { "type": "number", "minimum": -3, "maximum": 2, "description": "Stops of exposure applied to camera-log footage before its LUT (negative recovers footage that was shot too bright: clouds come back in a blown sky). Only used with `lut`." },
        "levels": { "type": "object", "additionalProperties": false, "description": "A brightness correction for every clip of this source: gamma above 1 lifts the middle tones of footage that is too dark, below 1 pulls down footage that is too bright. Applied after the LUT and before the grade.", "properties": { "gamma": { "type": "number", "minimum": 0.4, "maximum": 2.5 }, "brightness": { "type": "number", "minimum": -0.4, "maximum": 0.4 }, "contrast": { "type": "number", "minimum": 0.5, "maximum": 2 }, "saturation": { "type": "number", "minimum": 0, "maximum": 3 } } },
        "proxy": { "$ref": "#/$defs/relPath" },
        "credit": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "scene": {
      "type": "object",
      "required": ["id", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string" },
        "start": { "type": "number", "minimum": 0 },
        "end": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "clip": {
      "type": "object",
      "required": ["id", "source", "in", "out", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/id" },
        "in": { "type": "number", "minimum": 0 },
        "out": { "type": "number", "exclusiveMinimum": 0 },
        "at": { "type": "number", "minimum": 0 },
        "speed": { "type": "number", "minimum": 0.25, "maximum": 4 },
        "gainDb": { "type": "number", "minimum": -60, "maximum": 12 },
        "mute": { "type": "boolean" },
        "fit": { "enum": ["cover", "contain", "fill"] },
        "focal": { "$ref": "#/$defs/focal" },
        "zoom": {
          "description": "Ken Burns push-in or pull-out over the clip: zoom factors (1 = the whole cover-cropped frame). For a photo, the clip's length is out minus in.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "from": { "type": "number", "minimum": 1, "maximum": 4 },
            "to": { "type": "number", "minimum": 1, "maximum": 4 },
            "ease": { "enum": ["linear", "in", "out", "in-out"] }
          }
        },
        "pan": {
          "description": "Slide the frame across the picture over the clip: where the centre of the crop sits (0 to 1 across and down the source), at the start and at the end. A missing 'from' is the clip's focal point.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "from": { "$ref": "#/$defs/focal" },
            "to": { "$ref": "#/$defs/focal" },
            "ease": { "enum": ["linear", "in", "out", "in-out"] }
          }
        },
        "grade": { "description": "A light, consistent look: none, neutral (a little contrast and colour), soft (neutral with a hint of warmth) or warm.", "enum": ["none", "warm", "soft", "neutral"] },
        "denoise": { "description": "Smooth camera noise (for footage shot in low light).", "type": "boolean" },
        "cleanAudio": { "description": "Noise reduction for this clip's sound: a low cut under 90 Hz and an FFT denoiser that learns the steady background (wind, crowd hum, air conditioning). Speech is kept.", "type": "boolean" },
        "transition": {
          "description": "How this clip comes in from the one before it, over its first 'duration' seconds. fade is a cross-dissolve, dip goes through black, slide pushes the new picture in. The outgoing clip's picture is held (or continues) for that time; sound is never affected.",
          "type": "object",
          "required": ["type"],
          "additionalProperties": false,
          "properties": {
            "type": { "enum": ["cut", "fade", "dip", "slide"] },
            "duration": { "type": "number", "minimum": 0.05, "maximum": 2 },
            "direction": { "description": "slide only: where the new picture comes from.", "enum": ["left", "right", "up", "down"] }
          }
        },
        "fade": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "in": { "type": "number", "minimum": 0 },
            "out": { "type": "number", "minimum": 0 }
          }
        },
        "duck": {
          "description": "Lower this clip while the named track has sound.",
          "type": "object",
          "required": ["under", "amountDb"],
          "additionalProperties": false,
          "properties": {
            "under": { "$ref": "#/$defs/id" },
            "amountDb": { "type": "number", "minimum": -60, "maximum": 0 },
            "attack": { "type": "number", "minimum": 0 },
            "release": { "type": "number", "minimum": 0 }
          }
        },
        "note": { "type": "string" }
      }
    },
    "track": {
      "type": "object",
      "required": ["id", "type", "clips"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "enum": ["video", "audio"] },
        "name": { "type": "string" },
        "mute": { "type": "boolean" },
        "solo": { "type": "boolean" },
        "lock": { "type": "boolean" },
        "clips": { "type": "array", "items": { "$ref": "#/$defs/clip" } }
      }
    },
    "captions": {
      "type": "object",
      "required": ["source"],
      "additionalProperties": false,
      "properties": {
        "source": { "$ref": "#/$defs/id" },
        "enabled": { "type": "boolean" },
        "highlight": { "enum": ["none", "word", "line"] },
        "maxWordsPerLine": { "type": "integer", "minimum": 1, "maximum": 12 },
        "position": { "enum": ["top-third", "center", "bottom-third"] },
        "style": { "$ref": "#/$defs/style" },
        "fixes": {
          "description": "What was heard -> what to show, for example {\"Noodle\": \"Nordle\"}. Matches whole words, ignoring case and punctuation. A single word can also carry its own 'fix' in the transcript file.",
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "highlightColor": { "description": "Colour of the spoken word (or line). Default: the brand's captionStyle.highlightColor, else its accent.", "$ref": "#/$defs/colour" },
        "animate": { "description": "Give each new caption line a quick pop-in. Default true.", "type": "boolean" }
      }
    },
    "timeline": {
      "type": "object",
      "required": ["fps", "duration", "tracks"],
      "additionalProperties": false,
      "properties": {
        "fps": { "enum": [24, 25, 30, 50, 60] },
        "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 900 },
        "cover": { "description": "Time (seconds) of the frame used for the cover image. Default: 0.3 s into the first scene.", "type": "number", "minimum": 0 },
        "background": { "description": "What shows where no clip is on the picture tracks: a colour, a brand token or a linear gradient. Without it the gap is black (and flagged). A reel made only of text and shapes uses this.", "$ref": "#/$defs/fill" },
        "tracks": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/track" } },
        "scenes": { "type": "array", "items": { "$ref": "#/$defs/scene" } },
        "captions": { "$ref": "#/$defs/captions" }
      }
    }
  }
}
