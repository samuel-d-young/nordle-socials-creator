{
  "$schema": "../../../schemas/doc.schema.json",
  "schema": "nordle.doc/0.1",
  "id": "open-late-story",
  "title": "Open late Friday",
  "kind": "graphic",
  "colourway": "night",
  "brand": "little-gannet",
  "sizes": ["ig-story-9x16", "ig-feed-4x5"],
  "copy": {
    "caption": "Open till 8 pm this Friday with live music from 6. Bring a friend.",
    "hashtags": ["#littlegannet", "#portwren"],
    "alt": { "main": "The words Open till 8 pm above a steaming cup of coffee." }
  },
  "pages": [
    {
      "id": "main",
      "title": "Open late",
      "background": {
        "type": "linear", "angle": 180,
        "stops": [{ "at": 0, "color": "$brand.colors.paper" }, { "at": 1, "color": "#14201F" }]
      },
      "layers": [
        {
          "id": "kicker", "type": "text", "text": "THIS FRIDAY",
          "layout": { "anchor": "top-left", "x": 8, "y": 14, "w": 70 },
          "style": { "font": "$brand.fonts.body", "size": 34, "weight": 600, "letterSpacing": 0.2, "color": "$brand.colors.accent" },
          "overrides": { "ig-feed-4x5": { "layout": { "y": 9 } } },
          "animate": [{ "preset": "fade-in", "at": 0, "duration": 0.4 }]
        },
        {
          "id": "headline", "type": "text",
          "runs": [
            { "text": "Open till\n" },
            { "text": "8 pm", "style": { "italic": true, "color": "$brand.colors.accent" } }
          ],
          "layout": { "anchor": "top-left", "x": 8, "y": 17.5, "w": 84 },
          "style": { "font": "$brand.fonts.display", "size": 170, "weight": 700, "lineHeight": 0.98, "color": "$brand.colors.ink", "balance": true },
          "overrides": { "ig-feed-4x5": { "layout": { "y": 14 }, "style": { "size": 150 } } },
          "animate": [{ "preset": "rise-in", "at": 0.1, "duration": 0.8 }]
        },
        {
          "id": "sub", "type": "text", "text": "Live music from 6.\nBring a friend.",
          "layout": { "anchor": "top-left", "x": 8, "y": 37, "w": 60 },
          "style": { "font": "$brand.fonts.body", "size": 46, "weight": 400, "lineHeight": 1.3, "color": "$brand.colors.muted" },
          "overrides": { "ig-feed-4x5": { "layout": { "y": 39 } } }
        },
        {
          "id": "halo", "type": "shape", "shape": "ellipse",
          "layout": { "anchor": "center", "x": 50, "y": 62, "w": 64, "h": 36 },
          "style": { "fill": "$brand.colors.accent" },
          "overrides": { "ig-feed-4x5": { "layout": { "y": 76, "w": 66, "h": 52.8 } } }
        },
        {
          "id": "cup", "type": "image", "src": "assets/hero-cup.svg", "fit": "contain",
          "alt": "A steaming cup of coffee on a saucer",
          "layout": { "anchor": "bottom", "x": 50, "y": 78, "w": 56, "h": "auto" },
          "overrides": { "ig-feed-4x5": { "layout": { "y": 100, "w": 60 } } }
        },
        {
          "id": "pill", "type": "shape", "shape": "rect",
          "layout": { "anchor": "center", "x": 50, "y": 83, "w": 56, "h": 5.5 },
          "style": { "fill": "$brand.colors.accent", "radius": 999 },
          "overrides": { "ig-feed-4x5": { "hidden": true } }
        },
        {
          "id": "pill-text", "type": "text", "text": "See you there",
          "layout": { "anchor": "center", "x": 50, "y": 83, "w": 56 },
          "style": { "font": "$brand.fonts.body", "size": 38, "weight": 600, "align": "center", "color": "#14201F" },
          "overrides": { "ig-feed-4x5": { "hidden": true } }
        }
      ]
    }
  ]
}
